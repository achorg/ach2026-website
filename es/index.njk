---
layout: default
description: "ACH 2026 — Conferencia anual de la Association for Computers and the Humanities. Virtual, 24-26 de junio de 2026. Tema: Emergence/ia."
aboutEvent: Una conferencia virtual que presenta el trabajo de miembros de la comunidad ACH.
---
<!-- ======= Hero Section ======= -->
<section id="hero" style="background:#1C1832;">
  <div style="overflow:hidden;">
    <iframe style="width:100%; height: 100vh; position:absolute; z-index: 2; filter: grayscale(100%) contrast(1.5) opacity(0.8);" src="/background" title="Fondo animado decorativo" aria-hidden="true" tabindex="-1" frameborder="0"></iframe>
  <div class="hero-container" >
    <img height="150" style="z-index:2;" src="/assets/img/idea.svg" alt="Logo de la conferencia ACH 2026" / >
    <h1 class="mb-4 pb-0" style="z-index:2;"><span class="ach">ach</span>2026</h1>
    <p class="mb-4 pb-0" style="z-index:2;">24-26 de junio de 2026, Conferencia virtual</p>    
    <a target="_blank" href="https://members.ach.org/civicrm/event/info/?id=37&reset=1" class="about-btn scrollto">Inscribirse</a>
    </div>
  </div>
  
 
</section><!-- End Hero Section -->

<main id="main">
 {% if settings.about %}
  <!-- ======= About Section ======= -->
  <section id="about">
    <div class="container" data-aos="fade-up">

      <div class="row">
        <div class="col-lg-6">
          <h3>Sobre ACH 2026</h3>
          <p>ACH 2026 es la conferencia anual de la Association for Computers and the Humanities, que reúne a investigadores, profesionales y estudiantes que trabajan en la intersección de la tecnología y las humanidades. El tema de este año, <em>Emergence/ia</em>, invita a reflexionar sobre cómo la práctica de las humanidades digitales surge de momentos de crisis, creatividad y comunidad, y responde a ellos — incluido el compromiso de esta conferencia con la participación multilingüe e interregional.</p>
          <p>La conferencia es totalmente virtual, con sesiones programadas para llegar a participantes en más de doce zonas horarias que abarcan las Américas, Europa, el Medio Oriente, el sur de Asia y el este de Asia.</p>
          <a href="/es/programa" class="btn-about-program">Explora el programa &rarr;</a>
        </div>
        <div class="col-lg-3">
          <h3>Dónde</h3>
          <p><strong>Zoom</strong> y <strong>WorkAdventure</strong><br><span class="text-muted">Totalmente virtual</span></p>
          <h3 class="mt-3">Cuándo</h3>
          <p>Miércoles a viernes<br>24–26 de junio de 2026</p>
          <p><small><a href="/es/talleres">Talleres pre-conferencia</a>: 22–23 de junio</small></p>
        </div>
        <div class="col-lg-3">
          <h3>En cifras</h3>
          {% if conftool.isConfigured %}
          <ul class="about-stats-list">
            <li><span class="about-stat-num">{{ conftool.totalPapers }}</span> presentaciones</li>
            <li><span class="about-stat-num">{{ conftool.totalSessions }}</span> sesiones</li>
            <li><span class="about-stat-num">{{ conftool.spanishCount }}</span> sesiones en español o bilingües</li>
            <li><span class="about-stat-num">3</span> talleres pre-conferencia</li>
            <li><span class="about-stat-num">5</span> grupos regionales</li>
            <li><span class="about-stat-num">12+</span> zonas horarias</li>
          </ul>
          {% else %}
          <ul class="about-stats-list">
            <li><span class="about-stat-num">70+</span> presentaciones</li>
            <li><span class="about-stat-num">22+</span> sesiones</li>
            <li><span class="about-stat-num">3</span> talleres pre-conferencia</li>
            <li><span class="about-stat-num">5</span> grupos regionales</li>
            <li><span class="about-stat-num">12+</span> zonas horarias</li>
          </ul>
          {% endif %}
        </div>
      </div>

    </div>
  </section><!-- End About Section -->
{% endif %}
{% if settings.speakers %}
<!-- ======= Speakers Section ======= -->
    <section id="speakers">
      <div class="container" data-aos="fade-up">
        <div class="section-header">
          <h2>Oradores principales</h2>
          <p>Aquí están algunos de nuestros oradores</p>
        </div>
        
        <div class="row">
        {% set speakers = collections.oradores %}
        {% for speaker in speakers %}
        
          <div class="col-lg-4 col-md-6">
            <div class="speaker" data-aos="fade-up" data-aos-delay="100">
              <img src="{{ speaker.data.image }}" alt="{{ speaker.data.name }}" class="img-fluid">
              <div class="details">
                <h3><a href="speaker-details.html">{{ speaker.data.name }}</a></h3>
                <p>{{ speaker.data.description }}</p>
                
              </div>
            </div>
          </div>
        {% endfor %}
          
          
        </div>
      </div>

    </section><!-- End Speakers Section -->
{% endif %}
{% if settings.partners %}
    <!-- ======= Supporters Section ======= -->
    <section id="partners" class="section-with-bg">

      <div class="container" data-aos="fade-up">
        <div class="section-header">
          <h2>Socios</h2>
        </div>
        
        <div class="row no-gutters supporters-wrap clearfix" data-aos="zoom-in" data-aos-delay="100">
          {% set partners = collections.partners %}
        {% for partner in partners %} 
        {# {% for name, item in partner %}
      <li>{{ name }}: {{ item }}</li>
   {% endfor %} #}
      
        <div class="col-lg-6 col-md-6 col-xs-6">
            <div class="supporter-logo">
              <img src="{{ partner.data.image }}" class="rounded img-fluid" alt="{{ partner.data.name }}">
            </div>
          </div>
        {% endfor %}
          
          

        </div>

      </div>

    </section><!-- End Sponsors Section -->
{% endif %}
    {% if settings.faq %}
    <!-- =======  F.A.Q Section ======= -->
    <section id="faq">

      <div class="container" data-aos="fade-up">

        <div class="section-header">
          <h2>Preguntas frecuentes</h2>
        </div>

        <div class="row justify-content-center" data-aos="fade-up" data-aos-delay="100">
          <div class="col-lg-9">

            <ul class="faq-list">
              {% for faq in es_faq.items %}
              <li>
                <div data-bs-toggle="collapse" class="collapsed question" href="#faq{{loop.index}}">{{ faq.question }} <i class="bi bi-chevron-down icon-show"></i><i class="bi bi-chevron-up icon-close"></i></div>
                <div id="faq{{loop.index}}" class="collapse" data-bs-parent=".faq-list">
                  <p>
                    {{ faq.answer }}
                  </p>
                </div>
              </li>
              {% endfor %}
              
            </ul>

          </div>
        </div>

      </div>

    </section><!-- End  F.A.Q Section -->
{% endif %}
