---
layout: default
description: "ACH 2026 — Association for Computers and the Humanities annual conference. Virtual, June 24-26, 2026. Theme: Emergence/ia."
aboutEvent: A virtual conference featuring work by members of the ACH community.
---
<!-- ======= Hero Section ======= -->
<section id="hero" style="background:#1C1832;">
  <div style="overflow:hidden;">
    <iframe style="width:100%; height: 100vh; position:absolute; z-index: 2; filter: grayscale(100%) contrast(1.5) opacity(0.8);" src="/background" title="Decorative animated background" aria-hidden="true" tabindex="-1" frameborder="0"></iframe>
  <div class="hero-container" >
    <img height="150" style="z-index:2;" src="/assets/img/idea.svg" alt="ACH 2026 conference logo" / >
    <h1 class="mb-4 pb-0" style="z-index:2;"><span class="ach">ach</span>2026</h1>
    <p class="mb-4 pb-0" style="z-index:2;">24–26 June 2026, Virtual Conference</p>    
    <a target="_blank" href="https://members.ach.org/civicrm/event/info/?id=37&reset=1" class="about-btn scrollto">Register</a>
    </div>
  </div>
  
 
</section><!-- End Hero Section -->
 
 
<main id="main">
 {% if settings.about %}
  <!-- ======= About Section ======= -->
  <section id="about">
    <div class="container" data-aos="fade-up">

      <div class="row">
        <div class="col-lg-6">
          <h3>About ACH 2026</h3>
          <p>ACH 2026 is the annual conference of the Association for Computers and the Humanities, bringing together scholars, practitioners, and students who work at the intersection of technology and the humanities. This year's theme, <em>Emergence/ia</em>, invites reflection on how digital humanities practice emerges from and responds to moments of crisis, creativity, and community—including this conference's commitment to multilingual and cross-regional participation.</p>
          <p>The conference is fully virtual, with sessions scheduled to reach participants across more than twelve time zones spanning the Americas, Europe, the Middle East, South Asia, and East Asia.</p>
          <a href="/en/program" class="btn-about-program">Explore the Program &rarr;</a>
        </div>
        <div class="col-lg-3">
          <h3>Where</h3>
          <p><strong>Zoom</strong> &amp; <strong>WorkAdventure</strong><br><span class="text-muted">Fully virtual</span></p>
          <h3 class="mt-3">When</h3>
          <p>Wednesday–Friday<br>June 24–26, 2026</p>
          <p><small><a href="/en/workshops">Pre-conference workshops</a>: June 22–23</small></p>
        </div>
        <div class="col-lg-3">
          <h3>By the Numbers</h3>
          {% if conftool.isConfigured %}
          <ul class="about-stats-list">
            <li><span class="about-stat-num">{{ conftool.totalPapers }}</span> presentations</li>
            <li><span class="about-stat-num">{{ conftool.totalSessions }}</span> sessions</li>
            <li><span class="about-stat-num">{{ conftool.spanishCount }}</span> Spanish / bilingual sessions</li>
            <li><span class="about-stat-num">3</span> pre-conference workshops</li>
            <li><span class="about-stat-num">5</span> regional hubs</li>
            <li><span class="about-stat-num">12+</span> time zones</li>
          </ul>
          {% else %}
          <ul class="about-stats-list">
            <li><span class="about-stat-num">70+</span> presentations</li>
            <li><span class="about-stat-num">22+</span> sessions</li>
            <li><span class="about-stat-num">3</span> pre-conference workshops</li>
            <li><span class="about-stat-num">5</span> regional hubs</li>
            <li><span class="about-stat-num">12+</span> time zones</li>
          </ul>
          {% endif %}
        </div>
      </div>

    </div>
  </section><!-- End About Section -->
  {% endif %}

{% if settings.speakers %}
<!-- ======= Speakers Section ======= -->
    <section id="speakers">
      <div class="container" data-aos="fade-up">
        <div class="section-header">
          <h2>Keynote Speakers</h2>
          <p>Here are some of our speakers</p>
        </div>
        
        <div class="row">
        {% set speakers = collections.speakers %}
        {% for speaker in speakers %}
        
          <div class="col-lg-4 col-md-6">
            <div class="speaker" data-aos="fade-up" data-aos-delay="100">
              <img src="{{ speaker.data.image }}" alt="{{ speaker.data.name }}" class="img-fluid">
              <div class="details">
                <h3><a href="speaker-details.html">{{ speaker.data.name }}</a></h3>
                <p>{{ speaker.data.description }}</p>
                
              </div>
            </div>
          </div>
        {% endfor %}
          
          
        </div>
      </div>

    </section><!-- End Speakers Section -->
{% endif %}
{% if settings.partners %}
    <!-- ======= Supporters Section ======= -->
    <section id="partners" class="section-with-bg">

      <div class="container" data-aos="fade-up">
        <div class="section-header">
          <h2>Partners</h2>
        </div>
        
        <div class="row no-gutters supporters-wrap clearfix" data-aos="zoom-in" data-aos-delay="100">
          {% set partners = collections.partners %}
        {% for partner in partners %} 
        {# {% for name, item in partner %}
      <li>{{ name }}: {{ item }}</li>
   {% endfor %} #}
      
        <div class="col-lg-6 col-md-6 col-xs-6">
            <div class="supporter-logo">
              <img src="{{ partner.data.image }}" class="rounded img-fluid" alt="{{ partner.data.name }}">
            </div>
          </div>
        {% endfor %}
          
          

        </div>

      </div>

    </section><!-- End Sponsors Section -->
    {% endif %}
    {% if settings.faq %}
    <!-- =======  F.A.Q Section ======= -->
    <section id="faq">

      <div class="container" data-aos="fade-up">

        <div class="section-header">
          <h2>F.A.Q </h2>
        </div>

        <div class="row justify-content-center" data-aos="fade-up" data-aos-delay="100">
          <div class="col-lg-9">

            <ul class="faq-list">
              {% for faq in en_faq.items %}
              <li>
                <div data-bs-toggle="collapse" class="collapsed question" href="#faq{{loop.index}}">{{ faq.question }} <i class="bi bi-chevron-down icon-show"></i><i class="bi bi-chevron-up icon-close"></i></div>
                <div id="faq{{loop.index}}" class="collapse" data-bs-parent=".faq-list">
                  <p>
                    {{ faq.answer }}
                  </p>
                </div>
              </li>
              {% endfor %}
              
            </ul>

          </div>
        </div>

      </div>

    </section><!-- End  F.A.Q Section -->
{% endif %}